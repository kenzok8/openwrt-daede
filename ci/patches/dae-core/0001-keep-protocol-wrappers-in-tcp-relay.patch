+type relayProtocolConn struct {
+	net.Conn
+}
+
+func (c *relayProtocolConn) UnderlyingConn() net.Conn {
+	return c.Conn
+}
+
+func TestUnwrapRelayTCPConnStopsAtProtocolWrapper(t *testing.T) {
+	socket := new(net.TCPConn)
+	wrapped := &relayProtocolConn{Conn: socket}
+	for _, conn := range []net.Conn{wrapped, &prefixedConn{Conn: wrapped}, &bufioConn{Conn: wrapped}} {
+		if tcp, ok := unwrapRelayTCPConn(conn); tcp != nil || ok {
+			t.Fatalf("unwrapRelayTCPConn(%T) = (%v, %v), want no raw socket", conn, tcp, ok)
+		}
+	}
+}
